# ==============================================================================
# MILKGUARD — Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operational Mode Configuration
# ------------------------------------------------------------------------------
# Set to 'true' for standalone demonstration with in-memory persistence.
# Set to 'false' for production connected mode with live MongoDB database.
DEMO_MODE=true
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Optional in Vercel same-domain deployment (defaults to relative '/api').
# For standalone/decoupled frontend hosting, provide the full backend origin.
VITE_API_BASE=/api
FRONTEND_URL=https://your-milkguard-deployment.vercel.app

# ------------------------------------------------------------------------------
# 3. Backend Server & Security Configuration (Node / Express)
# ------------------------------------------------------------------------------
PORT=5000
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=https://your-milkguard-deployment.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Database Configuration (MongoDB Atlas / Live Database)
# ------------------------------------------------------------------------------
# Required when DEMO_MODE=false. Leave as placeholder or omit in DEMO_MODE.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/milkguard_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 5. Machine Learning Service Configuration (FastAPI Microservice)
# ------------------------------------------------------------------------------
# URL of the Python FastAPI prediction microservice.
# If offline/unreachable, backend automatically uses built-in baseline screening.
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. ESP32 IoT Device Telemetry Configuration
# ------------------------------------------------------------------------------
ESP32_API_KEY=replace_with_production_master_esp32_key
DEVICE_HEARTBEAT_TIMEOUT_MS=60000


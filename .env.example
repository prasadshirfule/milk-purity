# Global Mode Configuration
DEMO_MODE=true

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Ignored when DEMO_MODE=true)
MONGODB_URI=mongodb://localhost:27017/milk_purity_db

# Machine Learning Service URL (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Authentication & Security
JWT_SECRET=super_secret_dairy_token_key_change_in_production
JWT_EXPIRES_IN=7d

# IoT Hardware & ESP32
ESP32_API_KEY=esp32_milk_analyzer_secret_token_2026
DEVICE_HEARTBEAT_TIMEOUT_MS=60000

{
  "name": "milkguard-system",
  "version": "1.0.0",
  "description": "MILKGUARD — Smart Milk Quality & Dairy Management System with ESP32 IoT telemetry and ML prediction readiness",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm run test --prefix backend",
    "simulate:esp32": "npm run simulate:esp32 --prefix backend",
    "typecheck:frontend": "npm run typecheck --prefix frontend",
    "typecheck:backend": "npm run typecheck --prefix backend",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend"
  },
  "keywords": [
    "milkguard",
    "dairy",
    "milk-quality",
    "iot",
    "esp32",
    "dashboard",
    "smart-dairy"
  ],
  "author": "MILKGUARD Systems",
  "license": "ISC",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "concurrently": "^8.2.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
